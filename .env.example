# Application
APP_NAME=QuizForge
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

# Database (SQLite - No installation required!)
DATABASE_URL="file:./database.db"

# JWT Secret (Generate a strong secret for production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# AI Providers (Choose one - Gemini is FREE!)
# Get FREE Gemini key: https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Which provider: "gemini" (FREE), "openai", or "anthropic"
AI_DEFAULT_PROVIDER=gemini
AI_RATE_LIMIT_PER_MINUTE=30
AI_DAILY_BUDGET=5.00

# Email (Optional - for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@quizforge.com
